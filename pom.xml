<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.when</groupId>
    <artifactId>when-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>When</name>
    <description>Distributed delayed-delivery component</description>

    <modules>
        <module>when-common</module>
        <module>when-observability</module>
        <module>when-sink-spi</module>
        <module>when-sink-http</module>
        <module>when-sink-kafka</module>
        <module>when-delivery</module>
        <module>when-api</module>
        <module>when-admin-api</module>
        <module>when-admin-web</module>
        <module>when-storage-redis</module>
        <module>when-cluster</module>
        <module>when-timewheel</module>
        <module>when-ingress-router</module>
        <module>when-test-support</module>
        <module>when-app</module>
        <module>when-e2e-test</module>
        <module>when-acceptance</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <junit.version>5.11.4</junit.version>
        <protobuf.version>3.25.5</protobuf.version>
        <jackson.version>2.19.1</jackson.version>
        <jedis.version>5.0.0</jedis.version>
        <jetcd.version>0.7.7</jetcd.version>
        <netty.version>4.1.122.Final</netty.version>
        <grpc.version>1.50.2</grpc.version>
        <kafka.version>3.9.1</kafka.version>
        <micrometer.version>1.13.6</micrometer.version>
        <micrometer.tracing.version>1.3.6</micrometer.tracing.version>
        <opentelemetry.version>1.38.0</opentelemetry.version>
        <slf4j.version>2.0.16</slf4j.version>
        <logback.version>1.4.11</logback.version>
        <spring-boot.version>3.3.4</spring-boot.version>
        <swagger-annotations.version>2.2.22</swagger-annotations.version>
        <maven.compiler.version>3.13.0</maven.compiler.version>
        <maven.surefire.version>3.5.0</maven.surefire.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-common</artifactId>
                <version>${netty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.version}</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
