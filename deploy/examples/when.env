# Copy to an untracked local file and replace these documentation-only hosts.
WHEN_NODE_ID=when-local-1
WHEN_WORKER_ID=1
WHEN_HTTP_PORT=8080
WHEN_MANAGEMENT_HOST=127.0.0.1
WHEN_MANAGEMENT_PORT=8081
WHEN_GRPC_PORT=9090
WHEN_TIMEWHEEL_COUNT=1
WHEN_ETCD_ENDPOINTS=https://etcd.example.internal:2379
WHEN_REDIS_HOST=redis.example.internal
WHEN_REDIS_PORT=6379
WHEN_REDIS_TLS=true
WHEN_KAFKA_BOOTSTRAP_SERVERS=
OTEL_EXPORTER_OTLP_ENDPOINT=
WHEN_LOG_LEVEL=INFO
WHEN_LOG_FORMAT=json
WHEN_SHUTDOWN_TIMEOUT=30s
# Set WHEN_ETCD_USERNAME, WHEN_ETCD_PASSWORD, WHEN_REDIS_USERNAME, and
# WHEN_REDIS_PASSWORD only in your shell, secret manager, or an untracked local
# env file.
