# Non-secret observability settings. Inject credentials separately if the platform requires them.
WHEN_MANAGEMENT_HOST=127.0.0.1
WHEN_MANAGEMENT_PORT=8081
WHEN_RUNTIME_LOG_LEVEL_ENABLED=false
OTEL_SERVICE_NAME=when
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
WHEN_LOG_LEVEL=INFO
WHEN_LOG_FORMAT=json
